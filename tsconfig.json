{
  "// purpose": "Type-checks the library, the examples and the scratch fixtures — and is the config the plugin/printer reads when the tests drive them. The extension has its own.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["release/**/*.ts", "release/**/*.mts", "examples/**/*.ts", "scratch/**/*.ts"],
  "exclude": ["release/vscode-extension/**", "examples/mistakes.ts", "**/node_modules/**"]
}
